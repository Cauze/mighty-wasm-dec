;; Reference types + table access shapes.
(module
  (table $t 4 funcref)
  (func (export "rnull") (result funcref)
    (ref.null func))
  (func (export "risnull") (param funcref) (result i32)
    (ref.is_null (local.get 0)))
  (func (export "rfunc") (result funcref)
    (ref.func 0))
  (func (export "tget") (param i32) (result funcref)
    (table.get $t (local.get 0)))
  (func (export "tset") (param i32 funcref)
    (table.set $t (local.get 0) (local.get 1)))
  (func (export "tsize") (result i32)
    (table.size $t))
  (func (export "tgrow") (param funcref i32) (result i32)
    (table.grow $t (local.get 0) (local.get 1)))
  (func $target (param i32) (result i32) (local.get 0))
  (func (export "rselect") (param funcref funcref i32) (result funcref)
    (select (result funcref) (local.get 0) (local.get 1) (local.get 2))))
