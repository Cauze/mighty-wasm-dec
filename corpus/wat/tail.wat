;; Tail calls + typed function references.
(module
  (table 1 funcref)
  (elem (i32.const 0) $t)
  (type $ii (func (param i32) (result i32)))
  (func $t (param i32) (result i32) (local.get 0))
  (func (export "tail") (param i32) (result i32)
    (return_call $t (local.get 0)))
  (func (export "tailind") (param i32 i32) (result i32)
    (return_call_indirect (type $ii) (local.get 0) (local.get 1)))
  (func (export "callref") (param funcref i32) (result i32)
    (call_ref $ii (local.get 0) (local.get 1)))
  (func (export "asnn") (param funcref) (result funcref)
    (ref.as_non_null (local.get 0)))
  (func (export "bon") (param funcref) (result i32)
    (block (result i32)
      (br_on_null 0 (local.get 0))
      (drop)
      (i32.const 1))))
